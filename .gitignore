# Rust build artifacts
/target
**/*.rs.bk
**/*.pdb

# Capture/session output (evidence - jangan commit data besar)
/captures/*
!/captures/.gitkeep
/sessions/*
!/sessions/.gitkeep

# Config lokal
*.local.toml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# Waveform / capture sementara
*.raw
*.bin
!testdata/**/*.raw
!testdata/**/*.bin

# Backup partisi device (data asli, besar, sensitif - JANGAN commit)
/backups/*
!/backups/.gitkeep

# Build output & installer (binary besar - jangan commit)
/dist/
*.zip
*.msi
*-setup.exe

# Simulasi STB: berkas kerja (kernel, rootfs, image - besar, bisa diunduh ulang)
/scripts/stb-sim/work/
*.cpio.gz
*.img
